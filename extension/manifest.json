{
  "manifest_version": 3,
  "name": "Unique Dispatch - Relay Sync Engine",
  "version": "1.0.1",
  "description": "Enterprise real-time trip synchronization from Amazon Relay to Unique Dispatch Operations Portal",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Unique Dispatch Relay Sync Settings",
    "default_icon": "icons/icon48.png"
  },
  "permissions": [
    "storage",
    "alarms",
    "scripting",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "https://relay.amazon.com/*",
    "https://*.relay.amazon.com/*",
    "https://*.amazon.com/*",
    "https://*.amazon.co.uk/*",
    "https://*.amazon.de/*",
    "https://*.amazon.ca/*",
    "http://localhost:*/*",
    "http://127.0.0.1:*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://relay.amazon.com/*",
        "https://*.relay.amazon.com/*",
        "https://*.amazon.com/*",
        "https://*.amazon.co.uk/*",
        "https://*.amazon.de/*",
        "https://*.amazon.ca/*"
      ],
      "js": [
        "content/content-script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*",
        "content/relay-interceptor.js"
      ],
      "matches": [
        "https://relay.amazon.com/*",
        "https://*.relay.amazon.com/*",
        "https://*.amazon.com/*",
        "https://*.amazon.co.uk/*",
        "https://*.amazon.de/*",
        "https://*.amazon.ca/*"
      ]
    }
  ]
}
