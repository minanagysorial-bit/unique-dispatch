# Google Gemini API Key for Delay Report Generation
GEMINI_API_KEY=your_gemini_api_key_here

# Server Port
PORT=3000

# Automation Settings
MOCK_MODE=true
HEADLESS_BROWSER=false
RELAY_CHECK_INTERVAL_SEC=30
AUTO_DIAL_STOPPED_DRIVERS=false
OPENPHONE_ACCOUNT_URL=https://my.openphone.com
AMAZON_RELAY_URL=https://relay.amazon.com/tours/in-transit
